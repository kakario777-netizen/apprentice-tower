; 견습마법사의 탑 — 고도 엔진 버전
config_version=5

[application]
config/name="견습마법사의 탑"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.016, 0.03, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[display]
window/size/viewport_width=832
window/size/viewport_height=384
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
limits/opengl/max_lights_per_object=16
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.016, 0.03, 1)
textures/default_filters/anisotropic_filtering_level=2

[importer_defaults]
texture={
"compress/mode": 0,
"mipmaps/generate": true,
"detect_3d/compress_to": 0,
"process/fix_alpha_border": true
}

[gui]
theme/custom_font="res://fonts/GowunDodum-Regular.ttf"
